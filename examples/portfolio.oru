title = "Alex Morgan — Designer"
description = "Selected design and development work."

class Intro:
    class.background = "#f1f1f1"
    class.padding = 48
    class.radius = 20

page index:
    Intro:
        stack:
            stack.gap = 12
            heading("Hello, I'm Alex"):
                heading.size = 44
            text("I design and build for the web."):
                text.size = 20
            link("See my projects", "#projects"):
                link.color = "#2457d6"

    section:
        section.padding = 32
        heading("Selected projects")
        grid:
            grid.columns = 2
            grid.gap = 24
            box:
                text("Project One")
                text("A small description of the project.")
            box:
                text("Project Two")
                text("A small description of the project.")

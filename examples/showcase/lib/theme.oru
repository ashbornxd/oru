class PageShell:
    background: #fbfbfd
    padding: 24
    gap: 20
    width: 100%
    crossAlign: stretch

class HeroPanel:
    background: #f0f3fa
    padding: 24
    radius: 20
    gap: 12
    width: 100%

class MutedText:
    color: #65718a
    size: 14

class ActionButton:
    background: #234fd6
    color: #ffffff
    size: 16
    weight: 600
    radius: 12
    padding: 14
    width: 220
    hover.background: #193eae
    active.background: #122f88
    disabled.background: #cbd2e2
    disabled.color: #68738a

class FieldStyle:
    background: #ffffff
    color: #172033
    size: 16
    radius: 10
    padding: 12
    width: 100%

page:
    text("Shared ORU theme module")

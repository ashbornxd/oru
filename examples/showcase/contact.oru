from lib.theme import PageShell, HeroPanel, MutedText, ActionButton, FieldStyle

metadata:
    title: "ORU Native Controls"
    description: "Test native browser form controls and validation."
    language: "en"

logic:
    state email = ""
    state topic = "website"
    state message = ""
    state attachment = ""
    state password = ""
    state confirmation = ""
    state status = "This form runs locally. Nothing is sent."
    func validateDemo():
        if len(email) > 3 and len(message) >= 8:
            status = "Form passed validation. No data was sent."
        else:
            status = "Complete the required fields and try again."

page:
    column:
        class: PageShell
        text("NATIVE CONTROLS"):
            class: MutedText
        text("A real browser form, powered by ORU."):
            size: 32
            weight: 700
        box:
            class: HeroPanel
            form:
                on.submit: validateDemo
                validationSummary: true
                input(email):
                    type: email
                    required: true
                    autocomplete: email
                    placeholder: "you@example.com"
                    label: Email address
                    class: FieldStyle
                text("We will use this only as the example contact address."):
                    class: MutedText
                select(topic):
                    required: true
                    label: What are you building?
                    placeholder: "Choose a project type"
                    class: FieldStyle
                    option("Website"):
                        value: "website"
                    option("Browser application"):
                        value: "browser-app"
                    option("Experiment"):
                        value: "experiment"
                text("Pick the type that best describes your project."):
                    class: MutedText
                textarea(message):
                    required: true
                    minLength: 8
                    maxLength: 400
                    rows: 5
                    placeholder: "Tell us what you are making and what it should do..."
                    label: Project description
                    class: FieldStyle
                text("Describe the main features or goal of your project."):
                    class: MutedText
                input(password):
                    type: password
                    required: true
                    placeholder: "Enter a demo passphrase"
                    minLength: 8
                    label: Demo passphrase
                    class: FieldStyle
                text("Use 8 or more characters."):
                    class: MutedText
                input(confirmation):
                    type: password
                    required: true
                    matches: password
                    placeholder: "Enter it again"
                    validationMessage: "Passphrases must match."
                    label: Confirm passphrase
                    class: FieldStyle
                text("Re-enter the same passphrase to confirm it."):
                    class: MutedText
                input(attachment):
                    type: file
                    accept: ".png,.jpg,.jpeg,.pdf"
                    label: Optional attachment (filename only)
                    class: FieldStyle
                text("Optional. Choose a PNG, JPG, or PDF. Only the filename is displayed."):
                    class: MutedText
                button("Validate demo form"):
                    class: ActionButton
            text(status)
            text(attachment)
        link("Back home", "index")

title = "ORU Documentation"
description = "Learn ORU, a simple language for building websites."
background = "#f8f9fc"

class Card:
    class.background = white
    class.padding = 24
    class.radius = 14

class CodeBlock:
    class.background = "#eaf0f8"
    class.padding = 16
    class.radius = 12

page index:
    nav:
        nav.background = white
        nav.padding = 18 6%
        nav.gap = 24

        heading("ORU"):
            heading.size = 26
            heading.color = "#315efb"

        link("Documentation", "index.html"):
            link.color = "#315efb"
        link("Language Guide", "guide.html"):
            link.color = "#315efb"
        link("GitHub", "https://github.com/ashbornxd/oru"):
            link.color = "#315efb"

    section:
        section.padding = 80 8
        section.align = center

        text("THE WEB, SIMPLIFIED"):
            text.size = 12
            text.weight = bold
            text.color = "#315efb"
            text.space = 2

        heading("Build for the web."):
            heading.size = 52
            heading.weight = bold
            heading.color = "#171923"

        text("A simple programming language for creating websites."):
            text.size = 18
            text.color = "#64748b"

        stack:
            stack.gap = 12
            stack.align = center

            button("Get started", "go guide.html"):
                button.background = "#315efb"
                button.color = white
                button.padding = 14 24
                button.radius = 8

            link("View on GitHub", "https://github.com/ashbornxd/oru"):
                link.color = "#315efb"

    section:
        section.padding = 40 8

        heading("Get started"):
            heading.size = 32

        text("Install ORU and create your first website."):
            text.color = "#64748b"

        CodeBlock:
            text("npm install -g @ashbornxd/oru"):
                text.size = 15
                text.color = "#171923"

        CodeBlock:
            text("oru create my-website\\ncd my-website\\noru run dev"):
                text.size = 15
                text.color = "#171923"

    section:
        section.padding = 40 8

        heading("Why ORU?"):
            heading.size = 32

        grid:
            grid.columns = 3
            grid.gap = 16

            Card:
                heading("Simple syntax"):
                    heading.size = 21
                text("Write readable code using indentation and simple expressions.")

            Card:
                heading("Web focused"):
                    heading.size = 21
                text("Build websites with ORU instead of manually writing HTML.")

            Card:
                heading("Fast builds"):
                    heading.size = 21
                text("Compile projects into static web files.")

    section:
        section.padding = 40 8

        heading("Your first ORU page"):
            heading.size = 32

        text("A small example of what ORU code looks like."):
            text.color = "#64748b"

        CodeBlock:
            text("title = \"My Website\"\\n\\npage index:\\n    section:\\n        heading(\"Hello, web!\")\\n        text(\"Built with ORU.\")"):
                text.size = 14
                text.color = "#171923"

    section:
        section.padding = 40 8

        heading("Explore the documentation"):
            heading.size = 32

        Card:
            heading("Language basics"):
                heading.size = 22
            text("Learn about project settings, pages, elements, styling and reusable classes.")
            link("Read the language guide", "guide.html"):
                link.color = "#315efb"

        Card:
            heading("CLI reference"):
                heading.size = 22
            text("Create, develop and build ORU projects.")
            text("oru create  |  oru run dev  |  oru build"):
                text.color = "#315efb"

    section:
        section.background = "#171923"
        section.padding = 32 8

        heading("ORU"):
            heading.size = 26
            heading.color = white

        text("A simpler way to build for the web."):
            text.color = "#a0aec0"

        text("Built by Orlune · MIT License"):
            text.color = "#64748b"

page guide:
    nav:
        nav.background = white
        nav.padding = 18 6
        nav.gap = 24

        heading("ORU"):
            heading.size = 26
            heading.color = "#315efb"

        link("Home", "index.html"):
            link.color = "#315efb"
        link("GitHub", "https://github.com/ashbornxd/oru"):
            link.color = "#315efb"

    section:
        section.padding = 48 8

        text("DOCUMENTATION"):
            text.color = "#315efb"
            text.weight = bold

        heading("Language basics"):
            heading.size = 42

        text("Everything you need to understand the ORU language."):
            text.color = "#64748b"

        divider()

        heading("1. Project settings"):
            heading.size = 26
        text("Define your website title and description at the top of your file.")
        CodeBlock:
            text("title = \"My Website\"\\ndescription = \"My first ORU website.\"\\nbackground = \"#ffffff\""):
                text.size = 14

        heading("2. Pages"):
            heading.size = 26
        text("The index page becomes index.html. Other pages become their own HTML files.")
        CodeBlock:
            text("page index:\\n    section:\\n        heading(\"Home\")\\n\\npage about:\\n    heading(\"About\")"):
                text.size = 14

        heading("3. Elements"):
            heading.size = 26
        text("Structure: section, box. Layout: stack, grid. Content: heading, text, image, video, divider. Actions: button, link. Forms: form, input. Lists: list, item. Navigation: nav.")
        CodeBlock:
            text("page index:\\n    section:\\n        heading(\"Welcome\")\\n        text(\"Hello from ORU!\")\\n        image(\"assets/photo.jpg\", \"A landscape\")"):
                text.size = 14

        heading("4. Styling"):
            heading.size = 26
        text("Use element-scoped properties. The style scope must match the element.")
        CodeBlock:
            text("section:\\n    section.background = \"#f4f4f4\"\\n    section.padding = 24\\n\\n    heading(\"Hello\"):\\n        heading.size = 36\\n        heading.color = white"):
                text.size = 14

        heading("5. Reusable classes"):
            heading.size = 26
        text("Define a reusable wrapper once, then use its name inside a page.")
        CodeBlock:
            text("class Card:\\n    class.background = white\\n    class.padding = 24\\n    class.radius = 12\\n\\npage index:\\n    Card:\\n        heading(\"My Card\")"):
                text.size = 14

        heading("6. Layouts"):
            heading.size = 26
        text("Use stack for vertical layouts and grid for responsive columns.")
        CodeBlock:
            text("grid:\\n    grid.columns = 3\\n    grid.gap = 20\\n    box:\\n        text(\"Card one\")"):
                text.size = 14

        heading("7. Build your project"):
            heading.size = 26
        CodeBlock:
            text("oru run dev\\noru build"):
                text.size = 14
        text("Generated website files are written to the dist directory.")

    section:
        section.background = "#171923"
        section.padding = 30 8

        heading("ORU"):
            heading.color = white
        text("Build. Create. Explore."):
            text.color = "#a0aec0"

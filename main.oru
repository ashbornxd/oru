title = "My Portfolio"
description = "A simple website built with ORU."
background = "#f7f7f7"

class Intro:
    class.background = white
    class.padding = 48
    class.radius = 20

page index:
    Intro:
        stack:
            stack.gap = 16
            heading("Welcome to my portfolio"):
                heading.size = 42
                heading.color = "#171717"
                heading.align = center
            text("Thanks for visiting my little corner of the web."):
                text.size = 18
                text.color = "#666666"
                text.align = center
            button("Explore my work", "go #work"):
                button.background = "#171717"
                button.color = white
                button.padding = 12 20
                button.radius = 10

    section:
        section.padding = 40
        heading("My work")
        grid:
            grid.columns = 3
            grid.gap = 20
            box:
                text("Project one")
            box:
                text("Project two")
            box:
                text("Project three")

{
  "name": "@ashbornxd/oru",
  "version": "1.0.0-dev.0",
  "description": "The next-generation ORU programming language and browser application runtime.",
  "type": "module",
  "bin": {
    "oru": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ashbornxd/oru.git"
  },
  "homepage": "https://github.com/ashbornxd/oru#readme",
  "bugs": {
    "url": "https://github.com/ashbornxd/oru/issues"
  },
  "keywords": [
    "oru",
    "orlune",
    "programming-language",
    "web-development",
    "website-builder",
    "compiler"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts run dev",
    "compile": "tsx src/cli.ts build",
    "test": "tsx --test src/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "exports": {
    "./language": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  }
}

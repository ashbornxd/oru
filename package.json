{
  "name": "@orlune/oru",
  "version": "0.2.0",
  "description": "A simple, Python-inspired language for building websites.",
  "type": "module",
  "bin": {
    "oru": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts run dev",
    "compile": "tsx src/cli.ts build",
    "test": "tsx --test src/*.test.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}

{
  "name": "@ashbornxd/oru",
  "version": "0.3.0",
  "description": "A Python-inspired language and compiler for building responsive websites.",
  "type": "module",
  "bin": { "oru": "dist/cli.js" },
  "files": ["dist/", "README.md", "LICENSE"],
  "repository": { "type": "git", "url": "https://github.com/ashbornxd/oru.git" },
  "homepage": "https://github.com/ashbornxd/oru#readme",
  "bugs": { "url": "https://github.com/ashbornxd/oru/issues" },
  "keywords": ["oru", "orlune", "programming-language", "web-development", "website-builder", "compiler"],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts run dev",
    "compile": "tsx src/cli.ts build",
    "test": "tsx --test src/*.test.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "license": "MIT"
}